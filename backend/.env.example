# =============================================================================
# WAVE INIT LMS Backend - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual config.
# NEVER commit the real .env file with secrets to source control.
# =============================================================================

# Server Environment
PORT=3001
NODE_ENV=development

# Frontend & CORS Configuration
# Set to your frontend deployment URL (e.g., https://waveinint.azurewebsites.net or custom domain)
FRONTEND_URL=http://localhost:5173
# Additional comma-separated origins allowed for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# =============================================================================
# Database Configuration (PostgreSQL / MySQL / Supabase / Aiven)
# =============================================================================
# Option 1: Full Connection URL (Recommended for Supabase / Neon / Render / Azure)
DATABASE_URL=postgresql://username:password@host:port/database

# Option 2: Individual DB Parameters
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_POOL_MAX=20

# =============================================================================
# Authentication & Security
# =============================================================================
# Generate strong 64-character random hex strings:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-character-random-hex-string-for-jwt-access-tokens
JWT_REFRESH_SECRET=your-64-character-random-hex-string-for-jwt-refresh-tokens

# Proctoring encryption key (32 bytes / 64 hex characters)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROCTOR_ENC_KEY=

# Token & Rate Limit Settings
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_SESSIONS_PER_USER=10

# =============================================================================
# Cloud Media Storage (Cloudinary - Optional for user avatars and PDFs)
# =============================================================================
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# =============================================================================
# AI & Proctoring Services (Optional)
# =============================================================================
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_google_gemini_api_key
# Second Gemini credential, tried after GEMINI_API_KEY fails and before Groq.
# Both Gemini keys are loaded from ai-service/.env when missing locally.
GEMINI_API_KEY2=
# Model available to new Gemini projects; 2.5 Flash-Lite rejects new users.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# Email & Notifications (SMTP / Gmail - Optional for password reset & OTPs)
# =============================================================================
APP_NAME=WAVE INIT LMS
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_gmail_app_password

# =============================================================================
# Redis Cache & Background Queue (Optional - will fallback in-memory)
# =============================================================================
# REDIS_URL=redis://localhost:6379
RUN_EMBEDDED_WORKERS=true
MONITORING_VIDEO_STORAGE=false

# =============================================================================
# Azure App Service Scale-Out (multi-instance) Configuration
# =============================================================================
# Instance identity. On Azure, leave blank to auto-derive from WEBSITE_INSTANCE_ID
# (falls back to hostname + PID). Set an explicit value only for local multi-instance tests.
# INSTANCE_ID=

# Shared filesystem root so ALL App Service instances read/write the SAME files.
# Every instance of one Azure web app mounts the same Azure-Files home folder:
#   Windows App Service (B2 plan): D:\home\data
#   Linux App Service:              /home/data
# Defaults to <backend>/storage (single-instance). Must point at the shared mount when scaling out.
# SHARED_STORAGE_PATH=D:\home\data

# Legacy single-folder override (kept for compatibility; SHARED_STORAGE_PATH wins).
# UPLOADS_PATH=

# Distributed lock TTL / heartbeat (ms). Only tweak if you know what you're doing.
# LEADER_TTL_MS=120000
# HEARTBEAT_MS=30000

# All text features try GEMINI_API_KEY, then GEMINI_API_KEY2, then GROQ_API_KEY.
# There is no static question fallback.
# GEMINI_MODEL above controls quiz, coding, mentor, chatbot, and source retrieval.
# Legacy feature-specific model variables and GEMINI_MODELS are ignored.

# Server-only backup provider. In local development missing Groq settings may
# also be read from ai-service/.env; deployment environment takes precedence.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_QUIZ_MODEL=
GROQ_MENTOR_MODEL=
GROQ_RETRIEVAL_MODEL=groq/compound
