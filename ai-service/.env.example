# ==============================================================================
# LMS AI Quiz & Proctoring Service - Environment Configuration Template
# ==============================================================================

# ── 1. Core AI / LLM Configuration (REQUIRED) ─────────────────────────────────
# Google Gemini API key for question generation, Bloom's taxonomy analysis, and RAG.
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_first_gemini_api_key_here
GEMINI_API_KEY2=your_second_gemini_api_key_here
# Text requests try Gemini key 1, then Gemini key 2, then Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── 2. Model & Service Settings (OPTIONAL) ─────────────────────────────────────
# One model for all Gemini text, document, and vision requests.
GEMINI_MODEL=gemini-3.5-flash-lite

# Port for local development (Azure App Service automatically injects $PORT)
AI_SERVICE_PORT=8000

# ── 3. RAG & Vector Store Configuration (OPTIONAL) ───────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_FALLBACK_MODEL=intfloat/e5-large-v2
AI_RETRIEVAL_TOP_K=5
AI_CHUNK_SIZE_TOKENS=650
AI_CHUNK_OVERLAP_TOKENS=100
AI_JSON_RETRY_COUNT=3
FAISS_INDEX_DIR=vector_store
GEMINI_CONTEXT_LIMIT_CHARS=150000
AI_MAX_FILE_SIZE_BYTES=26214400
AI_MIN_TEXT_CHARS=300

# ── 4. Computer Vision / Proctoring Engine (OPTIONAL) ────────────────────────
# Path to custom YOLO model weights (defaults to models/yolov8n.pt if unset)
YOLO_MODEL_PATH=models/yolov8n.pt

# ── 5. Backend Integration (OPTIONAL) ─────────────────────────────────────────
# URL of the LMS Node.js Backend service
BACKEND_URL=http://localhost:3001

# ── 6. Scale-Out / Readiness (OPTIONAL) ───────────────────────────────────────
# Instance identity surfaced on /health, /ready and /api/proctoring/status.
# On Azure you can leave blank to auto-derive from WEBSITE_INSTANCE_ID
# (falls back to hostname + PID). Set explicitly only for local multi-instance tests.
# INSTANCE_ID=

# Stale proctoring session eviction (seconds). Sessions idle longer than this are
# dropped from the in-memory dict to bound memory on a long-lived instance.
PROCTORING_SESSION_MAX_IDLE_SECONDS=900
