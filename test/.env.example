# Copy to .env for local runs. Localhost endpoints only.
FRONTEND_URL=https://localhost:5174
BACKEND_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000

# Seeded login accounts used by auth specs. Leave BLANK to auto-skip positive-login tests.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_TRAINER_EMAIL=
TEST_TRAINER_PASSWORD=
TEST_PARTICIPANT_EMAIL=
TEST_PARTICIPANT_PASSWORD=

# Optional API token for authenticated API specs.
TEST_API_TOKEN=